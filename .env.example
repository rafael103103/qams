# ---------- Server ----------
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000          # public URL, used in email links
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CRON_SECRET=another-long-random-string # protects /api/cron/reminders

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY   # server only, never expose to browser
STORAGE_BUCKET=qams-files

# ---------- SMTP ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password
MAIL_FROM="QAMS <your-account@example.com>"

# ---------- Google Gemini (free tier key from aistudio.google.com) ----------
GEMINI_API_KEY=YOUR-GEMINI-KEY
GEMINI_MODEL=gemini-2.0-flash
